@page
@model PragmaticBot.Server.Pages.Admin.NoticesModel
@{
    ViewData["Title"] = "공지";
}
<h1>공지</h1>
<p class="sub">활성 공지 중 가장 최근 것 하나가 봇 화면에 표시됩니다.</p>

<div class="panel">
    <h2 style="margin-top:0">새 공지</h2>
    <form method="post" asp-page-handler="Create">
        <label class="field">
            <span>내용</span>
            <textarea name="Message" required maxlength="2000" placeholder="봇 사용자에게 보여줄 내용"></textarea>
        </label>
        <div class="actions">
            <label class="checks"><input type="checkbox" name="Activate" value="true" checked /> 바로 활성화</label>
            <button type="submit">등록</button>
        </div>
    </form>
</div>

<div class="panel">
    <div class="table-wrap">
        <table>
            <thead><tr><th class="num">ID</th><th>내용</th><th>등록</th><th>상태</th><th></th></tr></thead>
            <tbody>
            @if (Model.Notices.Count == 0)
            {
                <tr><td colspan="5" class="empty">등록된 공지가 없습니다.</td></tr>
            }
            @foreach (var n in Model.Notices)
            {
                <tr>
                    <td class="num">@n.Id</td>
                    <td class="wrap-any">@n.Message</td>
                    <td class="mono">@PragmaticBot.Server.Services.KoreaTime.Fmt(n.CreatedUtc, "yyyy-MM-dd HH:mm")</td>
                    <td>
                        @if (n.IsActive && n.Id == Model.LiveNoticeId)
                        {
                            <span class="pill on">표시중</span>
                        }
                        else if (n.IsActive)
                        {
                            <span class="pill warn">활성</span>
                        }
                        else
                        {
                            <span class="pill off">비활성</span>
                        }
                    </td>
                    <td>
                        <div class="actions">
                            <form method="post" asp-page-handler="Toggle">
                                <input type="hidden" name="id" value="@n.Id" />
                                <button type="submit" class="small ghost">@(n.IsActive ? "내리기" : "게시")</button>
                            </form>
                            <form method="post" asp-page-handler="Delete" onsubmit="return confirm('삭제할까요?');">
                                <input type="hidden" name="id" value="@n.Id" />
                                <button type="submit" class="small danger">삭제</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
