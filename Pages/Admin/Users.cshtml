@page
@using PragmaticBot.Server.Data
@model PragmaticBot.Server.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "계정관리";
}
<h1>계정관리</h1>
<p class="sub">
    @Model.RoleLabel(Model.Me.Role) <strong>@Model.Me.Username</strong> 기준 —
    본인과 하위 조직만 보입니다.
</p>

@if (Model.CreatableRoles.Count > 0)
{
    <div class="panel">
        <h2 style="margin-top:0">계정 만들기</h2>
        <form method="post" asp-page-handler="Create">
            <div class="row">
                <label class="field">
                    <span>등급</span>
                    <select name="role" required>
                        @foreach (var r in Model.CreatableRoles)
                        {
                            <option value="@((int)r)">@Model.RoleLabel(r)</option>
                        }
                    </select>
                </label>
                <label class="field">
                    <span>상위 조직</span>
                    <select name="parentId" required>
                        @foreach (var p in Model.ParentChoices)
                        {
                            <option value="@p.Id" selected="@(p.Id == Model.Me.Id)">
                                @Model.RoleLabel(p.Role) · @p.Username
                            </option>
                        }
                    </select>
                </label>
                <label class="field"><span>아이디</span><input type="text" name="username" required maxlength="64" /></label>
                <label class="field"><span>표시 이름</span><input type="text" name="displayName" maxlength="64" /></label>
                <label class="field"><span>비밀번호</span><input type="text" name="password" required minlength="4" /></label>
                <label class="field"><span>만료일 (비우면 무제한)</span><input type="date" name="expirationDate" /></label>
                <div class="field">
                    <span>이용 게임</span>
                    <div class="checks" style="padding-top:6px">
                        @if (Model.Me.Providers.HasFlag(GameProviders.PragmaticPlay))
                        {
                            <label><input type="checkbox" name="useProviderPragmatic" value="true" checked /> 프라그마틱</label>
                        }
                        @if (Model.Me.Providers.HasFlag(GameProviders.Evolution))
                        {
                            <label><input type="checkbox" name="useProviderEvolution" value="true" /> 에볼루션</label>
                        }
                    </div>
                </div>
            </div>
            <button type="submit">계정 생성</button>
        </form>
    </div>
}

<div class="panel">
    <form method="get" class="filters">
        <label class="field"><span>검색</span><input type="text" name="q" value="@Model.Query" placeholder="아이디 또는 이름" /></label>
        <button type="submit">검색</button>
        <a class="btn ghost" href="@Url.Page("/Admin/Users")">전체</a>
    </form>

    <div class="table-wrap">
        <table>
            <thead>
            <tr>
                <th>조직 / 아이디</th><th>등급</th><th>이름</th><th>이용 게임</th><th>상태</th><th>만료일</th>
                <th>접속</th><th class="num">하위 회원</th><th class="num">배팅수</th><th></th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="10" class="empty">표시할 계정이 없습니다.</td></tr>
            }
            @foreach (var n in Model.Rows)
            {
                var u = n.User;
                var expired = u.ExpirationDate is { } e && e < DateTime.UtcNow;
                <tr>
                    <td>
                        <span class="tree-indent" style="width:@(n.Depth * 22)px"></span>@if (n.Depth > 0)
                        {
                            <span class="tree-branch">└</span>
                        }
                        <strong>@u.Username</strong>
                        @if (u.Id == Model.Me.Id)
                        {
                            <span class="pill warn">나</span>
                        }
                    </td>
                    <td><span class="pill role-@u.Role.ToString().ToLowerInvariant()">@Model.RoleLabel(u.Role)</span></td>
                    <td>@u.DisplayName</td>
                    <td><span class="pill off">@PragmaticBot.Server.Services.HierarchyService.ProvidersLabel(u.Providers)</span></td>
                    <td>
                        @if (!u.IsActive)
                        {
                            <span class="pill bad">비활성</span>
                        }
                        else if (expired)
                        {
                            <span class="pill bad">만료</span>
                        }
                        else
                        {
                            <span class="pill on">정상</span>
                        }
                    </td>
                    <td>@(PragmaticBot.Server.Services.KoreaTime.Fmt(u.ExpirationDate, "yyyy-MM-dd") ?? "무제한")</td>
                    <td>
                        @if (n.Online)
                        {
                            <span class="pill on">접속중</span>
                        }
                        else
                        {
                            <span class="pill off">–</span>
                        }
                    </td>
                    <td class="num">@(u.Role == UserRole.Member ? "" : n.MemberCount.ToString())</td>
                    <td class="num">@(n.BetCount == 0 ? "" : n.BetCount.ToString("N0"))</td>
                    <td>
                        @if (u.Id != Model.Me.Id)
                        {
                            <span class="rowactions">
                                <button type="button" class="btn small ghost" onclick="ktOpen('manage-@u.Id')">관리</button>
                                <button type="button" class="btn small ghost" onclick="ktOpen('extend-@u.Id')">연장</button>
                                <form method="post" action="/Admin/Users?handler=ForceLogout" style="display:inline" onsubmit="return confirm('@u.Username 세션을 강제 종료할까요?');">
                                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id" />
                                    <button type="submit" class="btn small ghost" @(n.Online ? "" : "disabled")>강제 로그아웃</button>
                                </form>
                                <form method="post" action="/Admin/Users?handler=Delete" style="display:inline" onsubmit="return confirm('@u.Username 계정과 모든 기록을 삭제합니다. 계속할까요?');">
                                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id" />
                                    <button type="submit" class="btn small danger">삭제</button>
                                </form>
                            </span>

                            @* ── 관리 모달 ── *@
                            <div class="kt-modal" id="manage-@u.Id">
                                <div class="kt-box">
                                    <div class="kt-head"><b>@u.Username 관리</b><button type="button" class="kt-x" onclick="ktClose('manage-@u.Id')">✕</button></div>
                                    <div class="kt-body">
                                        <form method="post" action="/Admin/Users?handler=Save">
                                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id" />
                                                    <div class="row">
                                                <label class="field"><span>아이디 (로그인)</span><input type="text" name="username" value="@u.Username" maxlength="64" autocomplete="off" /></label>
                                                <label class="field"><span>표시 이름</span><input type="text" name="displayName" value="@u.DisplayName" maxlength="64" /></label>
                                                <label class="field"><span>만료일 (비우면 무제한)</span><input type="date" name="expirationDate" value="@(PragmaticBot.Server.Services.KoreaTime.Fmt(u.ExpirationDate, "yyyy-MM-dd"))" /></label>
                                            </div>
                                            <div class="actions" style="margin:6px 0 12px">
                                                <label class="checks"><input type="checkbox" name="isActive" value="true" @(u.IsActive ? "checked" : "") /> 활성</label>
                                                <label class="checks"><input type="checkbox" name="useProviderPragmatic" value="true" @(u.Providers.HasFlag(GameProviders.PragmaticPlay) ? "checked" : "") /> 프라그마틱</label>
                                                <label class="checks"><input type="checkbox" name="useProviderEvolution" value="true" @(u.Providers.HasFlag(GameProviders.Evolution) ? "checked" : "") /> 에볼루션</label>
                                                <label class="checks"><input type="checkbox" name="diagnosticLogging" value="true" @(u.DiagnosticLogging ? "checked" : "") /> 진단 로그</label>
                                            </div>
                                            <button type="submit">저장</button>
                                        </form>
                                        <hr />
                                        <form method="post" action="/Admin/Users?handler=ResetPassword" class="actions">
                                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id" />
                                                    <input type="text" name="newPassword" placeholder="새 비밀번호" required minlength="4" style="width:180px" />
                                            <button type="submit" class="ghost">비밀번호 변경</button>
                                        </form>
                                        @{ var moveTargets = Model.Rows.Where(r => r.User.Role > u.Role && r.User.Id != u.Id).Select(r => r.User).ToList(); }
                                        @if (moveTargets.Count > 0)
                                        {
                                            <hr />
                                            <form method="post" action="/Admin/Users?handler=Move" class="actions">
                                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id" />
                                                            <select name="newParentId" style="max-width:280px">
                                                    @foreach (var p in moveTargets)
                                                    {
                                                        <option value="@p.Id" selected="@(p.Id == u.ParentId)">@Model.RoleLabel(p.Role) · @p.Username</option>
                                                    }
                                                </select>
                                                <button type="submit" class="ghost">소속 이동</button>
                                            </form>
                                        }
                                        <hr />
                                        <a class="btn small ghost" href="@Url.Page("/Admin/UserEdit", new { id = u.Id })">상세 보기 (사이트 슬롯 · 베팅내역)</a>
                                    </div>
                                </div>
                            </div>

                            @* ── 연장 모달 ── *@
                            <div class="kt-modal" id="extend-@u.Id">
                                <div class="kt-box">
                                    <div class="kt-head"><b>@u.Username 사용기간 연장</b><button type="button" class="kt-x" onclick="ktClose('extend-@u.Id')">✕</button></div>
                                    <div class="kt-body">
                                        <p class="muted" style="margin-top:0">현재 만료일: <b>@(PragmaticBot.Server.Services.KoreaTime.Fmt(u.ExpirationDate, "yyyy-MM-dd") ?? "무제한")</b></p>
                                        <form method="post" action="/Admin/Users?handler=Extend" class="actions">
                                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id" />
                                                    <input type="hidden" name="mode" value="months" />
                                            <span>개월수</span>
                                            <input type="number" name="months" min="1" max="120" value="1" style="width:80px" />
                                            <button type="submit">+개월 연장</button>
                                            <span class="muted">아직 유효하면 현재 만료일 뒤에 이어붙입니다.</span>
                                        </form>
                                        <hr />
                                        <form method="post" action="/Admin/Users?handler=Extend" class="actions">
                                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id" />
                                                    <input type="hidden" name="mode" value="date" />
                                            <span>날짜 지정</span>
                                            <input type="date" name="untilDate" />
                                            <button type="submit">날짜로 설정</button>
                                        </form>
                                        <hr />
                                        <form method="post" action="/Admin/Users?handler=Extend" class="actions" onsubmit="return confirm('@u.Username 을(를) 무제한으로 변경할까요?');">
                                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id" />
                                                    <input type="hidden" name="unlimited" value="true" />
                                            <button type="submit" class="ghost">무제한으로 변경</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<style>
    .rowactions { display:inline-flex; gap:6px; flex-wrap:wrap; align-items:center; }
    .kt-modal { display:none; position:fixed; inset:0; background:rgba(0,0,0,.6); z-index:1000; align-items:flex-start; justify-content:center; overflow:auto; padding:48px 12px; }
    .kt-modal.open { display:flex; }
    .kt-box { background:#12203a; border:1px solid #29406b; border-radius:10px; max-width:640px; width:100%; box-shadow:0 12px 44px rgba(0,0,0,.55); }
    .kt-head { display:flex; justify-content:space-between; align-items:center; padding:14px 18px; border-bottom:1px solid #29406b; font-size:16px; }
    .kt-x { background:none; border:none; color:#9fb0cc; cursor:pointer; font-size:18px; line-height:1; }
    .kt-body { padding:16px 18px; }
    .kt-body hr { border:none; border-top:1px solid #24365c; margin:14px 0; }
</style>
<script>
    function ktOpen(id){ var m=document.getElementById(id); if(m){ m.classList.add('open'); } }
    function ktClose(id){ var m=document.getElementById(id); if(m){ m.classList.remove('open'); } }
    document.addEventListener('click', function(e){
        if (e.target && e.target.classList && e.target.classList.contains('kt-modal')) { e.target.classList.remove('open'); }
    });
    document.addEventListener('keydown', function(e){
        if (e.key === 'Escape') { document.querySelectorAll('.kt-modal.open').forEach(function(m){ m.classList.remove('open'); }); }
    });
</script>
